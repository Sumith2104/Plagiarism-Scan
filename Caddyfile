{$DOMAIN:localhost} {
    encode gzip zstd

    # Forward all requests (frontend SPA + /api/v1/*) to unified backend container
    reverse_proxy app:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
